use core.intrinsic.{allocate,initialize,take,drop_slot,release,capacity,size_of,align_of};
pub fn main() -> i32 {
    if trusted_region() {
        var storage=allocate<i32>(3);
        initialize(storage,0,7);
        initialize(storage,1,9);
        drop_slot(storage,1);
        let result=take(storage,0);
        release(storage);
        return result;
    }
}
