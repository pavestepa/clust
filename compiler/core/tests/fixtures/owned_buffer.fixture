use core.storage.{OwnedBuffer,BufferResult};
pub class Item {
    pub value:i32
    new(n:i32) {value=n;}
    drop() {}
}
pub fn fetch() -> BufferResult<Item> {
    var buffer=OwnedBuffer<Item>.make(2);
    buffer.push(Item.new(3));
    buffer.push(Item.new(7));
    return buffer.pop();
}
pub fn main() -> i32 {
    return match fetch() {
        BufferResult.Some(item)=>item.value,
        BufferResult.None=>0
    };
}
