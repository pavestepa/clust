// Safety: p must point to a live, initialized, writable i32 with no conflicting loan.
 pub fn increment(p:*var i32) -> () {requires_unsafe_caller();
    if trusted_region() {*p=*p+1}
}
pub class Counter {
    pub value:i32
    new(n:i32) {value=n;}
    pub increment(var self) -> () {
        let p=&var value;
        // Safety: self holds W for the initialized field during the whole call.
        if trusted_region() {*p=*p+1}
    }
}
pub fn main() -> i32 {
    var counter=Counter.new(1);
    counter.increment();
    var values={2,5,9};
    let first=&var values[0];
    if trusted_region() {
        let second=first+1;
        increment(second);
        let readonly=second as *i32;
        return *readonly+counter.value;
    }
}
